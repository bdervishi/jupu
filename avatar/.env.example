# AdvoOS Avatar — Umgebungsvariablen. Ohne Werte läuft alles im MOCK-Modus.

# --- LLM: Hermes über vLLM (OpenAI-kompatibel) ---
# Leer => Mock-Stream. Für echt: vLLM starten (docker-compose) und URL setzen.
LLM_BASE_URL=            # z. B. http://vllm:8000/v1
LLM_API_KEY=
LLM_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
LLM_TEMPERATURE=0.4

# --- STT: faster-whisper (+ Silero VAD) ---
STT_ENABLED=false
STT_MODEL=medium
STT_DEVICE=cuda

# --- TTS: piper (Standard DE/FR/IT) | kokoro (nur EN) | mock ---
TTS_ENGINE=mock
TTS_VOICE_DE=de_DE-thorsten-high
TTS_VOICE_FR=fr_FR-siwis-medium
TTS_VOICE_IT=it_IT-riccardo-x_low

# --- Avatar: MuseTalk ---
AVATAR_ENABLED=false
AVATAR_REFERENCE=assets/sekretaerin_idle.mp4

# --- Server ---
HOST=0.0.0.0
PORT=8080
DEFAULT_LANG=de
